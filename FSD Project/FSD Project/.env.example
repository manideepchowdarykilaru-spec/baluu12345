NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/foodie_table
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
CLIENT_ORIGIN=http://127.0.0.1:4000,http://127.0.0.1:4173,http://127.0.0.1:5173,http://localhost:4000,http://localhost:4173,http://localhost:5173
# Set all three values to provision the protected administrator login. Use a unique
# password with at least 8 characters; it is hashed before MongoDB storage.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional Razorpay test/live keys. Online checkout stays disabled until both are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configure the same webhook secret in the Razorpay dashboard for payment.captured events.
RAZORPAY_WEBHOOK_SECRET=
# Local demo checkout records a test payment and never charges money.
# Automatically disabled when NODE_ENV=production; set false to turn off locally.
DEMO_ONLINE_PAYMENTS=true
# Must match the current menu price currency (INR paise).
PAYMENT_CURRENCY=INR
# Delivery fee configured by the restaurant, in paise. 0 means no fee is added.
DELIVERY_FEE_CENTS=0
